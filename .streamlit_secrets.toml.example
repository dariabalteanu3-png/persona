# ============================================
# Streamlit Cloud Secrets
# COPY to .streamlit/secrets.toml
# ============================================

# === DATABASE ===
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# === TTS ENGINE ===
# Pentru Streamlit Cloud:
USE_EDGE_TTS = "1"
# DEFAULT_EDGE_VOICE = "AlinaNeural"  # Feminin (default)
# DEFAULT_EDGE_VOICE = "EmilNeural"  # Masculin

# Pentru server propriu cu GPU (XTTS-v2 clonare):
# USE_EDGE_TTS = "0"

# === FISH AUDIO (metoda PRINCIPALĂ de clonare și generare a vocilor) ===
# Obține cheia gratuită de la https://fish.audio (Settings → API Keys).
# IMPORTANT: în Streamlit Cloud, numele secretului trebuie să fie EXACT acesta:
FISH_AUDIO_API_KEY = "..."

# Alias acceptat de cod (în cazul în care ai configurat deja cheia sub acest nume):
# FISH_API_KEY = "..."

# Modelul Fish Audio folosit (opțional — implicit s2.1-pro-free):
# FISH_AUDIO_MODEL = "s2.1-pro-free"

# === CHAT AI (răspunsurile text din conversații) ===
# Configurează cel puțin unul dintre providerii de mai jos.
# Nu include cheile reale în cod sau GitHub.
# GROQ_API_KEY = "gsk_..."     # furnizor PRINCIPAL (Grok)
# CEREBRAS_API_KEY = "csk_..."  # fallback automat #1 când Groq e indisponibil (https://cloud.cerebras.ai)
# OPENROUTER_API_KEY = "sk-or-..."  # fallback automat #2 (https://openrouter.ai/keys)
# GEMINI_API_KEY = "..."
# EMERGENT_LLM_KEY = "..."

# Ordinea automată a furnizorilor de chat: Grok → Cerebras → OpenRouter → Gemini → Emergent.

# === VOICE (Hugging Face token — pentru clone voce fără rate-limit) ===
# Obține un token gratuit de la https://huggingface.co/settings/tokens
# Pe Streamlit Cloud: adaugă-l în Settings → Secrets (NU îl commit-ui în git)
# HF_TOKEN = "hf_..."

# === OPTIONAL ===
# OPENAI_API_KEY = "sk-..."
