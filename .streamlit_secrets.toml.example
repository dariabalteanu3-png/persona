# ============================================
# Streamlit Cloud Secrets
# COPY to .streamlit/secrets.toml
# ============================================

# === DATABASE ===
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# === TTS ENGINE ===
# Pentru Streamlit Cloud:
USE_EDGE_TTS = "1"
# DEFAULT_EDGE_VOICE = "AlinaNeural"  # Feminin (default)
# DEFAULT_EDGE_VOICE = "EmilNeural"  # Masculin

# Pentru server propriu cu GPU (XTTS-v2 clonare):
# USE_EDGE_TTS = "0"

# === OPTIONAL ===
# OPENAI_API_KEY = "sk-..."
