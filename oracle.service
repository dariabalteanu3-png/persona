[Unit]
Description=GiftHub Persona - Streamlit + XTTS TTS Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/persona
Environment="PORT=8080"
Environment="TTS_SERVER_URL=http://localhost:5001"
ExecStart=/bin/bash -c 'source venv/bin/activate && bash run.sh'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
